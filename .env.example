# Local development (recommended): PostgreSQL 16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spenddesk?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/spenddesk?schema=public"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
SEED_DEMO_DATA="true"

# Optional hosted Supabase PostgreSQL:
# Use the Supabase Postgres connection string (pooler URL for DATABASE_URL).
# DIRECT_URL should use the direct database connection for Prisma migrations.
# This starter uses application-managed email/password auth stored in PostgreSQL.
# Supabase Auth can be integrated later; do not expose service-role keys in NEXT_PUBLIC vars.
